### files

msgid   "Select a file"
msgstr  "Selecciona un archivo"

msgid   "Go to path"
msgstr  "Ir a la ruta"

msgid   "Path"
msgstr  "Ruta"

msgid   "✖ The path must exist inside `DisManager`. E.g.: `DisManager/logs`."
msgstr  "✖ La ruta debe existir dentro de `DisManager`. Ej.: `DisManager/logs`."

msgid   "Upload files"
msgstr  "Subir archivos"

msgid   "Overwrite?"
msgstr  "¿Sobrescribir?"

msgid   "Replace existing files with the same name."
msgstr  "Reemplaza los archivos existentes con el mismo nombre."

msgid   "Files"
msgstr  "Archivos"

msgid   "Select up to 10 files to upload to the current directory."
msgstr  "Selecciona hasta 10 archivos para subir al directorio actual."

msgid   "✔ Uploaded:"
msgstr  "✔ Subidos:"

msgid   "✖ Already exists (skipped):"
msgstr  "✖ Ya existen (omitidos):"

msgid   "✖ Failed:"
msgstr  "✖ Fallaron:"

msgid   "Processing files..."
msgstr  "Procesando archivos..."

msgid   "Directory actions"
msgstr  "Acciones de carpeta"

msgid   "Calculate size"
msgstr  "Calcular tamaño"

msgid   "Compute total size of this directory"
msgstr  "Calcula el tamaño total de esta carpeta"

msgid   "Upload up to 10 files to this directory"
msgstr  "Sube hasta 10 archivos a esta carpeta"

msgid   "Delete directory"
msgstr  "Eliminar carpeta"

msgid   "Permanently delete this directory"
msgstr  "Elimina permanentemente esta carpeta"

msgid   "Are you sure you want to delete `{}`?"
msgstr  "¿Seguro que quieres eliminar `{}`?"

msgid   "✖ Could not delete directory: {}"
msgstr  "✖ No se pudo eliminar la carpeta: {}"

msgid   "✖ You cannot delete the root `DisManager` directory."
msgstr  "✖ No puedes eliminar el directorio raíz `DisManager`."

msgid   "Compress to .zip"
msgstr  "Comprimir a .zip"

msgid   "Create a .zip archive of this directory"
msgstr  "Crea un archivo .zip de esta carpeta"

msgid   "Are you sure you want to compress `{}` into `{}`? Any existing file with the same name will be overwritten."
msgstr  "¿Seguro que quieres comprimir `{}` en `{}`? Cualquier archivo existente con el mismo nombre será sobrescrito."

msgid   "Compressing `{}`..."
msgstr  "Comprimiendo `{}`..."

msgid   "✔ Compressed into `{}`."
msgstr  "✔ Comprimido en `{}`."

msgid   "✖ Failed to compress `{}` (exit code {})."
msgstr  "✖ No se pudo comprimir `{}` (código {})."

msgid   "✖ Failed to compress `{}`: {}"
msgstr  "✖ No se pudo comprimir `{}`: {}"
